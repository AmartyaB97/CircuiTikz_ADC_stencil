\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{adc_stencils}[2026/11/19 v1.2 Visio-Style CircuiTikZ/TikZ Stencil Library for ADC Publication Schematics]

% Required core packages
\RequirePackage{tikz}
\RequirePackage{amsmath,amssymb}

% TikZ Libraries
\usetikzlibrary{arrows.meta, calc, positioning, shapes.geometric, shapes.misc, patterns}

% -----------------------------------------------------------------------------
% 1. Global Stencil Styles (Pure Black & White Publication Default)
% -----------------------------------------------------------------------------
\tikzset{
    adc line/.style={draw=black, thick},
    adc wire/.style={draw=black, thick},
    adc arrow/.style={draw=black, thick, -{Latex[length=4.5pt, width=3.5pt]}},
    adc bus/.style={draw=black, line width=1.4pt},
    adc bus arrow/.style={draw=black, line width=1.4pt, -{Latex[length=5pt, width=4.5pt]}},
    adc block/.style={draw=black, thick, fill=white, rounded corners=2pt, align=center},
    adc circle/.style={draw=black, thick, fill=white, circle, inner sep=1pt}
}

% =============================================================================
% 2. INTERCONNECT, TERMINALS, PINS, & I/O PORTS
% =============================================================================

% --- 2.1 Terminal (Solid black junction dot for multi-way routing / current summing) ---
\tikzset{
    pics/terminal/.style args={#1}{
        code={
            \coordinate (-center) at (0, 0);
            \filldraw[black] (0, 0) circle (#1);
        }
    },
    pics/terminal/.default={1.6pt},
    pics/terminal_small/.style={
        code={
            \coordinate (-center) at (0, 0);
            \filldraw[black] (0, 0) circle (1.3pt);
        }
    },
    pics/terminal_large/.style={
        code={
            \coordinate (-center) at (0, 0);
            \filldraw[black] (0, 0) circle (2.2pt);
        }
    }
}

% --- 2.2 IO Port (Visio "I/O port" home-plate arrow tag for Vin/Vout) ---
% Pointed right tip at (0.35, 0), flat left edge at (-0.35, +/-0.14)
\tikzset{
    pics/ioport/.style args={#1}{
        code={
            \coordinate (-center) at (0, 0);
            \coordinate (-out) at (0.35, 0);
            \coordinate (-in) at (-0.35, 0);
            \draw[adc line, fill=white] (-0.35, 0.14) -- (0.12, 0.14) -- (0.35, 0) -- (0.12, -0.14) -- (-0.35, -0.14) -- cycle;
            \ifx&#1&\else
                \node[left=3pt, font=\small\bfseries] at (-0.35, 0) {#1};
            \fi
        }
    },
    pics/ioport/.default={}
}

% --- 2.3 IO Pin (Hollow pad / external pin circle with lead stub) ---
\tikzset{
    pics/iopin/.style args={#1/#2}{
        code={
            \coordinate (-center) at (0, 0);
            \coordinate (-lead) at (-#2, 0);
            \coordinate (-in) at (-#2, 0);
            \coordinate (-out) at (#1, 0);
            \draw[adc line] (-#2, 0) -- (-#1, 0);
            \draw[adc line, fill=white] (0, 0) circle (#1);
        }
    },
    pics/iopin/.default={2.4pt/0.3cm},
    pics/pin_small/.style={
        code={
            \coordinate (-center) at (0, 0);
            \coordinate (-lead) at (-0.25cm, 0);
            \coordinate (-in) at (-0.25cm, 0);
            \coordinate (-out) at (2.0pt, 0);
            \draw[adc line] (-0.25cm, 0) -- (-2.0pt, 0);
            \draw[adc line, fill=white] (0, 0) circle (2.0pt);
        }
    },
    pics/pin_large/.style={
        code={
            \coordinate (-center) at (0, 0);
            \coordinate (-lead) at (-0.35cm, 0);
            \coordinate (-in) at (-0.35cm, 0);
            \coordinate (-out) at (3.2pt, 0);
            \draw[adc line] (-0.35cm, 0) -- (-3.2pt, 0);
            \draw[adc line, fill=white] (0, 0) circle (3.2pt);
        }
    }
}

% --- 2.4 NoConn (Floating / unconnected terminal marker: square with X) ---
\tikzset{
    pics/noconn/.style args={#1}{
        code={
            \coordinate (-center) at (0, 0);
            \draw[adc line] (-#1, -#1) rectangle (#1, #1);
            \draw[adc line] (-#1, -#1) -- (#1, #1);
            \draw[adc line] (-#1, #1) -- (#1, -#1);
        }
    },
    pics/noconn/.default={2.5pt}
}

% --- 2.5 Jumper (Wire hop / bridge arc for crossing wires without connection) ---
\tikzset{
    pics/jumper/.style args={#1}{
        code={
            \coordinate (-in) at (-#1, 0);
            \coordinate (-out) at (#1, 0);
            \coordinate (-peak) at (0, #1);
            \coordinate (-center) at (0, 0);
            \draw[adc line] (-#1, 0) arc[start angle=180, end angle=0, radius=#1];
        }
    },
    pics/jumper/.default={0.2cm}
}

% --- 2.6 Bus Width Tick ---
\tikzset{
    pics/bus_tick/.style args={#1}{
        code={
            \coordinate (-center) at (0, 0);
            \draw[thick, black] (-0.1, -0.15) -- (0.1, 0.15);
            \node[below=1pt, font=\scriptsize\bfseries, text=black] at (0, -0.1) {#1};
        }
    },
    pics/bus_tick/.default={4b}
}

